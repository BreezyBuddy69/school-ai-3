# ── LG KI 2.0 — Umgebungsvariablen ─────────────────────────────────────────
# Ohne jede Variable startet die App im Demo-Modus (Mock-KI, Demo-Codes).

# Port ist überall 8100 (dev, start, Docker) — auf dem VPS sind
# 80/8080/8081/8082/8091 bereits belegt.

# Datenverzeichnis (SQLite + Exporte). Im Docker-Container: /data (Volume).
# Lokal default: ./data
# DATA_DIR=/data

# n8n-Webhook-Basis. Die Suffixe stehen in src/lib/n8n.ts.
# Ohne diese Variable: Demo-Modus (Mock-Antworten, klar gekennzeichnet).
# N8N_BASE=https://n8n.halovisionai.cloud/webhook

# Shared Secret, das jede Server→n8n-Anfrage im Header X-LGKI-Secret trägt.
# In n8n per IF-Node prüfen — dann kann niemand die Webhooks direkt aufrufen.
# N8N_SECRET=langer-zufallswert

# Admin-Zugang für /admin (Bearer-Token + Login-Feld auf der Seite).
# ADMIN_TOKEN=langer-zufallswert

# (Kein SESSION_SECRET nötig: Sessions sind Zufallstokens in der SQLite,
# src/lib/auth.ts — sie überleben Neustarts über das /data-Volume.)

# Öffentliche App-URL (für Share-Links, QR-Codes, Word-Footer).
# NEXT_PUBLIC_APP_URL=https://lgki.halovisionai.cloud

# Deployment hinter Pfad-Präfix statt Subdomain (Traefik PathPrefix):
# NEXT_PUBLIC_BASE_PATH=/lgki

# Echte KI-Stimme (Google Cloud Text-to-Speech, Neural2) für den Sprachmodus
# bei Pro/Premium (inkl. Anon-Trial, solange das Tages-Budget nicht
# ausgeschöpft ist). Ohne Key: automatischer Fallback auf die Browser-Stimme
# (window.speechSynthesis) — kein Fehler, keine Konfigurationspflicht.
# Google Cloud Console → „Cloud Text-to-Speech API" aktivieren → API-Key erzeugen.
# GOOGLE_TTS_API_KEY=dein-api-key
# GOOGLE_TTS_VOICE=de-DE-Neural2-F
